---
/**
 * CONNECT PAGE
 * ============
 * Guest speakers who have visited the club, and a plain-language look at what
 * technology careers actually involve. Speaker entries come from the Markdown
 * files in src/content/speakers/.
 */

import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import HexGrid from '../components/HexGrid.astro';
import Prompt from '../components/Prompt.astro';
import { href } from '../lib/href';
import { getMeetings } from '../lib/meetings';
import { CLUB } from '../config/site';

// Guest speakers are not a separate list any more: a visit IS a meeting, so
// we just pick out the meetings that had a speaker. One file, two pages, and
// no way for the two to disagree.
const { upcoming, past } = await getMeetings();
const visits = [...past, ...upcoming]
  .filter((meeting) => meeting.speaker)
  .sort((a, b) => b.id.localeCompare(a.id));

const rendered = await Promise.all(
  visits.map(async (meeting) => ({
    meeting,
    // The meeting write-up doubles as the note about the visit.
    Content: meeting.entry ? (await render(meeting.entry)).Content : null,
  })),
);

const dateFormat = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

/**
 * Career paths worth knowing about. This list is written here rather than in
 * Markdown because it changes rarely and is not something members add to.
 */
const CAREERS = [
  {
    icon: 'app-window',
    title: 'Software Engineering',
    blurb:
      'Writing the programs people use. Websites, phone apps, games, the software running inside cars and medical devices.',
  },
  {
    icon: 'shield',
    title: 'Cybersecurity',
    blurb:
      'Finding weaknesses before somebody else does, and keeping systems and the people using them safe.',
  },
  {
    icon: 'chart-line',
    title: 'Data & Machine Learning',
    blurb:
      'Turning piles of numbers into decisions, and building the systems that learn patterns from them.',
  },
  {
    icon: 'server',
    title: 'Infrastructure & Cloud',
    blurb:
      'Keeping things running: the servers, networks, and deployment systems everything else depends on.',
  },
];
---

<BaseLayout
  title="Connect"
  description="Guest speakers, industry visits, and technology career paths for Dev Club members."
>
  <section class="relative overflow-hidden border-b border-edge">
    <HexGrid class="opacity-50" />
    <div class="relative mx-auto max-w-6xl px-5 py-16">
      <Prompt command="dev-club connect" />
      <h1 class="mt-4 font-mono text-4xl font-bold tracking-tight">Connect</h1>
      <p class="mt-5 max-w-xl leading-relaxed text-muted">
        Technology is a much wider field than "person who codes". We invite
        people who do this work for a living to come talk about what their job
        is actually like, including the parts nobody puts in a brochure.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------------
      CAREER PATHS
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 py-14">
    <Prompt command="ls ./careers" />
    <h2 class="mt-3 font-mono text-2xl font-semibold">Where this can go</h2>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        CAREERS.map((career) => (
          <div class="rounded-lg border border-edge bg-surface p-6">
            <div class="flex items-center gap-3">
              <Icon name={`lucide:${career.icon}`} class="h-5 w-5 text-gold" />
              <h3 class="font-mono text-lg font-semibold">{career.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{career.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------------------
      GUEST SPEAKERS
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 pb-16">
    <Prompt command="ls ./speakers" />
    <h2 class="mt-3 font-mono text-2xl font-semibold">Guest speakers</h2>

    <div class="mt-8 space-y-5">
      {
        rendered.map(({ meeting, Content }) => (
          <article class="rounded-lg border border-edge bg-surface p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="font-mono text-lg font-semibold">
                {meeting.speaker!.name}
              </h3>
              <time
                datetime={meeting.id}
                class="font-mono text-xs text-muted"
              >
                {dateFormat.format(meeting.date)}
              </time>
            </div>

            <p class="mt-1 font-mono text-sm text-gold">{meeting.speaker!.role}</p>
            {meeting.speaker!.topic && (
              <p class="mt-3 text-sm text-bone">{meeting.speaker!.topic}</p>
            )}

            {Content && meeting.hasNotes && (
              <div class="md-content mt-3 space-y-3 text-sm leading-relaxed text-muted">
                <Content />
              </div>
            )}

            <div class="mt-4 flex flex-wrap gap-4">
              {meeting.speaker!.link && (
                <a
                  href={meeting.speaker!.link}
                  class="inline-flex items-center gap-1.5 font-mono text-xs text-cyan transition-colors hover:text-gold"
                >
                  <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
                  more about their work
                </a>
              )}
              <a
                href={href(`/meetings/${meeting.id}`)}
                class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-gold"
              >
                <Icon name="lucide:calendar" class="h-3.5 w-3.5" />
                that meeting
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 rounded-lg border border-dashed border-edge p-6">
      <p class="text-sm leading-relaxed text-muted">
        <span class="font-mono text-gold">//</span> Know somebody who works in
        tech and would talk to a room of high schoolers for half an hour? Tell {
          CLUB.advisorName
        } &mdash; that is genuinely how most of these visits happen.
      </p>
    </div>
  </section>
</BaseLayout>
