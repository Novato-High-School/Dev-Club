---
/**
 * ONE MEETING
 * ===========
 * A page per meeting, at a permanent address like /meetings/2026-09-14.
 *
 * The address never changes, which is what makes it safe to paste into a
 * Remind message or a Discord post: the link keeps working after the meeting,
 * and turns into the write-up.
 *
 * Pages are built for every scheduled date, not just ones with files, so the
 * link exists before anybody has written anything.
 */

import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../../layouts/BaseLayout.astro';
import HexGrid from '../../components/HexGrid.astro';
import Prompt from '../../components/Prompt.astro';
import { href } from '../../lib/href';
import { getMeetings, type Meeting } from '../../lib/meetings';
import { CLUB, SITE_URL } from '../../config/site';

export async function getStaticPaths() {
  const { upcoming, past } = await getMeetings();
  return [...upcoming, ...past].map((meeting) => ({
    params: { id: meeting.id },
    props: { meeting },
  }));
}

const { meeting } = Astro.props as { meeting: Meeting };

// The write-up, if somebody has written one.
const Notes = meeting.entry ? (await render(meeting.entry)).Content : null;

const dateFormat = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

const isPast = meeting.id < new Date().toISOString().slice(0, 10);

// Where to go to write this one up, straight into GitHub's editor.
const editUrl = meeting.entry
  ? `${CLUB.githubOrg}/Dev-Club/edit/main/src/content/meetings/${meeting.id}.md`
  : `${CLUB.githubOrg}/Dev-Club/new/main/src/content/meetings?filename=${meeting.id}.md`;

/**
 * The hard ceiling for the announcement, in characters.
 *
 * Remind caps an announcement at 140, and anything longer is cut off at the
 * far end — which is exactly where the link sits. A truncated link is a dead
 * link, so we enforce the limit ourselves rather than letting Remind do it.
 */
const ANNOUNCEMENT_LIMIT = 140;

/**
 * The date as 'Monday 9/21/26'. The weekday is spelled out because that is
 * the part a family actually acts on; the rest is numeric to save room.
 */
const announcementDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'numeric',
  day: 'numeric',
  year: '2-digit',
  timeZone: 'UTC',
}).format(meeting.date).replace(',', '');

/**
 * Turns a 24-hour 'HH:MM' into a 12-hour 'h:mm', with no am/pm.
 *
 * Dropping am/pm is safe here only because school meetings happen during the
 * school day — nobody reads '12:25' for a club and thinks midnight. If the
 * club ever meets in the evening, put the suffix back.
 */
function shortTime(hhmm: string): string {
  const [hours, minutes] = hhmm.split(':').map(Number);
  return `${hours % 12 || 12}:${String(minutes).padStart(2, '0')}`;
}

/**
 * How to say where it is.
 *
 * `where` is usually a bare room number from the config ('3202'), which reads
 * as nothing on its own in a text message, so it gets 'rm ' in front of it.
 * But a meeting can override it with real words — 'the library', 'the gym' —
 * and 'in rm the library' is nonsense, so the prefix is only added when the
 * value actually looks like a room number.
 */
const looksLikeRoomNumber = /^\d+[A-Za-z]?$/.test(meeting.where.trim());
const announcementWhere = looksLikeRoomNumber ? `rm ${meeting.where}` : meeting.where;

/**
 * A ready-made announcement, for pasting into Remind or Discord. We do not
 * integrate with Remind — it would need a server we do not have, and a person
 * still writes the message either way — so the site just makes the message
 * trivial to produce.
 *
 * WHY THIS IS WRITTEN SO TERSELY
 * ==============================
 *   1. It must fit in ANNOUNCEMENT_LIMIT characters, because Remind cuts the
 *      end off and the end is the link.
 *   2. Every character must be plain ASCII. One fancy character — a curly
 *      quote, an en dash, the '·' that `meeting.time` puts between 'Lunch'
 *      and the hours — re-encodes the whole text message, halving how much
 *      fits. That is why the separator is a plain hyphen and why we read
 *      `meeting.starts` rather than the prettier `meeting.time`.
 *   3. No agenda and no labels. What the meeting is about changes often and
 *      does not survive being squeezed into a sentence fragment, so the
 *      message carries the link and the page carries the detail.
 */
const announcementLink = `${SITE_URL}${href(`/meetings/${meeting.id}`)}`;

/**
 * Builds the message and, if it somehow runs long, gives up detail in a fixed
 * order rather than letting the end be chopped.
 *
 * Nothing standard gets close to the limit — a normal meeting lands around
 * 110 characters. This exists for the cases that are not standard: a meeting
 * moved to 'the multipurpose room behind the gym', or a future move to a
 * longer domain. The link is never shortened, since a cut link is worse than
 * no message at all.
 */
function buildAnnouncement(): string {
  const attempts = [
    // Everything.
    `Dev Club - ${announcementDate} ${shortTime(meeting.starts)} in ${announcementWhere}. ${announcementLink}`,
    // Drop the weekday; the numeric date still carries the day.
    `Dev Club - ${announcementDate.split(' ').slice(1).join(' ')} ${shortTime(meeting.starts)} in ${announcementWhere}. ${announcementLink}`,
    // Drop where it is. The page has it, and the link still works.
    `Dev Club - ${announcementDate.split(' ').slice(1).join(' ')} ${shortTime(meeting.starts)}. ${announcementLink}`,
  ];

  return (
    attempts.find((attempt) => attempt.length <= ANNOUNCEMENT_LIMIT) ??
    // Every version was too long, which means the link alone nearly fills the
    // budget. Send the link — it is the one part that has to survive.
    `Dev Club ${announcementLink}`
  );
}

const announcement = buildAnnouncement();
---

<BaseLayout
  title={`${dateFormat.format(meeting.date)} — ${meeting.title}`}
  description={meeting.agenda[0] ?? `Dev Club meeting on ${dateFormat.format(meeting.date)}.`}
>
  <section class="relative overflow-hidden border-b border-edge">
    <HexGrid class="opacity-50" />
    <div class="relative mx-auto max-w-3xl px-5 py-14">
      <a
        href={href('/meetings')}
        class="inline-flex items-center gap-1.5 font-mono text-xs text-muted transition-colors hover:text-gold"
      >
        <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />
        all meetings
      </a>

      <Prompt command={`cat meetings/${meeting.id}`} class="mt-5" />
      <h1 class="mt-3 font-mono text-3xl font-bold tracking-tight">
        {meeting.canceled ? 'No meeting' : meeting.title}
      </h1>
      <p class="mt-3 font-mono text-sm text-gold">
        {dateFormat.format(meeting.date)}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-12">
    {
      meeting.canceled ? (
        <div class="rounded-lg border border-edge bg-surface p-6">
          <p class="text-bone">
            No meeting this week{meeting.canceledReason ? ` — ${meeting.canceledReason}` : ''}.
          </p>
          <p class="mt-2 text-sm text-muted">
            Check the <a href={href('/meetings')} class="text-cyan hover:text-gold">meetings page</a>
            for the next one.
          </p>
        </div>
      ) : (
        <div class="rounded-lg border border-edge bg-surface p-6">
          <dl class="grid gap-4 font-mono text-sm sm:grid-cols-2">
            <div>
              <dt class="text-muted">time</dt>
              <dd class="mt-1 text-gold">{meeting.time}</dd>
            </div>
            <div>
              <dt class="text-muted">where</dt>
              <dd class="mt-1 text-gold">{meeting.where}</dd>
            </div>
          </dl>

          {meeting.unusual && (
            <p class="mt-5 flex gap-2.5 rounded border border-gold/40 bg-gold/10 p-3 text-sm text-bone">
              <Icon name="lucide:triangle-alert" class="mt-0.5 h-4 w-4 shrink-0 text-gold" />
              <span>
                <strong class="font-semibold">Not the usual time or place</strong> —
                check it before you head over.
              </span>
            </p>
          )}
        </div>
      )
    }

    {/* The guest, when there is one. */}
    {
      meeting.speaker && (
        <div class="mt-6 rounded-lg border border-cyan/30 bg-surface p-6">
          <h2 class="font-mono text-xs uppercase tracking-wide text-cyan">
            Guest speaker
          </h2>
          <p class="mt-3 font-mono text-lg font-semibold text-bone">
            {meeting.speaker.name}
          </p>
          <p class="mt-1 font-mono text-sm text-gold">{meeting.speaker.role}</p>
          {meeting.speaker.topic && (
            <p class="mt-3 text-sm text-muted">{meeting.speaker.topic}</p>
          )}
          {meeting.speaker.link && (
            <a
              href={meeting.speaker.link}
              class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-cyan transition-colors hover:text-gold"
            >
              <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
              more about their work
            </a>
          )}
        </div>
      )
    }

    {/* The plan. */}
    {
      meeting.agenda.length > 0 && (
        <div class="mt-6">
          <h2 class="font-mono text-xl font-semibold">
            {isPast ? 'The plan was' : 'What we are doing'}
          </h2>
          <ul class="mt-4 space-y-2">
            {meeting.agenda.map((item) => (
              <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                <span class="text-gold" aria-hidden="true">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {/* Pages we will open during the meeting. */}
    {
      meeting.links.length > 0 && (
        <div class="mt-6">
          <h2 class="font-mono text-xs uppercase tracking-wide text-muted">
            What we will use
          </h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {meeting.links.map((link) => (
              <a
                href={href(link.url)}
                class="rounded border border-edge px-3 py-1.5 font-mono text-xs text-cyan transition-colors hover:border-gold hover:text-gold"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      )
    }

    {/* The write-up, or a nudge to write one. */}
    {
      isPast && !meeting.canceled && (
        <div class="mt-10 border-t border-edge pt-8">
          <h2 class="font-mono text-xl font-semibold">What happened</h2>
          {meeting.hasNotes && Notes ? (
            <div class="md-content mt-4 space-y-4 text-sm leading-relaxed text-muted">
              <Notes />
            </div>
          ) : (
            <div class="mt-4 rounded-lg border border-dashed border-edge p-5">
              <p class="text-sm leading-relaxed text-muted">
                Nobody has written this one up yet. Three sentences is plenty:
                what did people work on, and did anything get finished?
              </p>
              <a
                href={editUrl}
                class="mt-4 inline-flex items-center gap-2 rounded border border-gold px-4 py-2 font-mono text-xs text-gold transition-colors hover:bg-gold hover:text-ink"
              >
                <Icon name="lucide:pencil" class="h-3.5 w-3.5" />
                Add notes
              </a>
            </div>
          )}
        </div>
      )
    }

    {/* Copy-ready announcement, so posting to Remind is one paste. */}
    {
      !isPast && !meeting.canceled && (
        <div class="mt-10 border-t border-edge pt-8">
          <h2 class="font-mono text-xs uppercase tracking-wide text-muted">
            Announcement text
          </h2>
          <p
            id="announcement"
            class="mt-3 rounded-lg border border-edge bg-surface p-4 text-sm leading-relaxed text-muted"
          >
            {announcement}
          </p>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <button
              type="button"
              id="copy-announcement"
              hidden
              class="inline-flex items-center gap-2 rounded border border-edge px-4 py-2 font-mono text-xs text-bone transition-colors hover:border-gold hover:text-gold"
            >
              <Icon name="lucide:copy" class="h-3.5 w-3.5" />
              Copy for Remind
            </button>
            {/* Filled in by the script below, so it never shows a stale count. */}
            <span id="announcement-count" class="font-mono text-xs text-muted" />
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: the button stays hidden unless JavaScript can
  // actually do the copying, so nobody clicks something that does nothing.
  const button = document.getElementById('copy-announcement');
  const text = document.getElementById('announcement')?.textContent?.trim();

  /**
   * Show how much of Remind's 140-character budget the message uses.
   *
   * The builder already guarantees it fits, so this is a readout rather than
   * a warning — it is here so that whoever edits the wording can see the cost
   * of a change straight away instead of finding out from Remind.
   *
   * It also checks for non-ASCII characters. One curly quote or dash pasted
   * into the wording re-encodes the whole text message and halves how much
   * fits, and that is invisible unless something says so.
   */
  const count = document.getElementById('announcement-count');

  if (count && text) {
    const LIMIT = 140;
    const plainAscii = /^[\x20-\x7E]*$/.test(text);

    count.textContent = plainAscii
      ? `${text.length}/${LIMIT} characters`
      : `${text.length}/${LIMIT} characters \u2014 a fancy character is costing you space`;

    // Amber as it gets close, or whenever a non-ASCII character sneaks in.
    if (!plainAscii || text.length > LIMIT - 15) {
      count.classList.replace('text-muted', 'text-gold');
    }
  }

  if (button && text && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = 'Copy for Remind'), 2000);
      } catch {
        button.textContent = 'Press Ctrl+C to copy';
      }
    });
  }
</script>
