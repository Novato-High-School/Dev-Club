---
/**
 * LEARN INDEX
 * ===========
 * The list of learning tracks. Each card links to that track's own page, built
 * from its Markdown file by src/pages/learn/[...slug].astro.
 *
 * This page deliberately shows only a summary. The steps, prerequisites and
 * links live on the track pages, so this one stays scannable.
 */

import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import HexGrid from '../components/HexGrid.astro';
import Prompt from '../components/Prompt.astro';
import { href } from '../lib/href';

// Lowest `order` number first, so the beginner tracks lead.
const tracks = (await getCollection('tracks')).sort(
  (a, b) => a.data.order - b.data.order,
);

// How each difficulty level is coloured.
const LEVEL_STYLES: Record<string, string> = {
  'start here': 'border-acid/40 text-acid',
  intermediate: 'border-gold/40 text-gold',
  advanced: 'border-cyan/40 text-cyan',
};
---

<BaseLayout
  title="Learn"
  description="Learning tracks at Dev Club: GitHub, Python, cloud deployment with Azure, and Apple development with Swift."
>
  <section class="relative overflow-hidden border-b border-edge">
    <HexGrid class="opacity-50" />
    <div class="relative mx-auto max-w-6xl px-5 py-16">
      <Prompt command="dev-club learn --list" />
      <h1 class="mt-4 font-mono text-4xl font-bold tracking-tight">Learn</h1>
      <p class="mt-5 max-w-xl leading-relaxed text-muted">
        Pick a track and start where you are. The two marked&#32;<span
          class="text-acid">start here</span
        >&#32;assume you have never written a line of code, and that is a
        completely normal place to begin.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------------
      NEW HERE? — the setup everything else depends on.
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 pt-12">
    <a
      href={href('/start')}
      class="group flex flex-wrap items-center gap-4 rounded-lg border border-gold/40 bg-gold/5 p-6 transition-colors hover:border-gold"
    >
      <Icon name="lucide:rocket" class="h-6 w-6 shrink-0 text-gold" />
      <div class="flex-1">
        <h2 class="font-mono text-lg font-semibold text-bone">
          Never used GitHub? Start here first
        </h2>
        <p class="mt-1.5 text-sm leading-relaxed text-muted">
          Making an account, getting the free student tools, joining our
          organization, and landing your first real change. Every track below
          assumes you have done this.
        </p>
      </div>
      <Icon
        name="lucide:arrow-right"
        class="h-5 w-5 shrink-0 text-gold transition-transform group-hover:translate-x-1"
      />
    </a>
  </section>

  {/* ------------------------------------------------------------------
      THE TRACKS
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 py-12">
    <div class="grid gap-5 sm:grid-cols-2">
      {
        tracks.map((track) => (
          <a
            href={href(`/learn/${track.id}`)}
            class="group flex h-full flex-col rounded-lg border border-edge bg-surface p-6 transition-colors hover:border-gold/40"
          >
            <div class="flex flex-wrap items-center gap-3">
              <Icon name={`lucide:${track.data.icon}`} class="h-5 w-5 text-gold" />
              <h2 class="font-mono text-xl font-semibold text-bone">
                {track.data.title}
              </h2>
              <span
                class:list={[
                  'rounded-full border px-2.5 py-0.5 font-mono text-xs',
                  LEVEL_STYLES[track.data.level] ?? 'border-edge text-muted',
                ]}
              >
                {track.data.level}
              </span>
            </div>

            <p class="mt-4 flex-1 text-sm leading-relaxed text-muted">
              {track.data.summary}
            </p>

            <div class="mt-5 flex items-center justify-between border-t border-edge pt-4">
              <span class="font-mono text-xs text-muted">
                <Icon name="lucide:clock" class="mr-1 inline h-3.5 w-3.5" />
                {track.data.time}
              </span>
              <span class="flex items-center gap-1.5 font-mono text-xs text-cyan transition-colors group-hover:text-gold">
                open track
                <Icon
                  name="lucide:arrow-right"
                  class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
