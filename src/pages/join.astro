---
/**
 * JOIN PAGE
 * =========
 * Meeting details, what to expect, and how to sign up.
 *
 * IMPORTANT — this page embeds Google's form, it does not host one:
 * the <iframe> below points straight at Google (see CLUB.interestFormEmbedUrl
 * in src/config/site.ts). Submissions go directly to Google, the same as if
 * a student had opened the form in its own tab — this static site never
 * sees, receives, or stores any of it.
 *
 * Set CLUB.interestFormUrl / interestFormEmbedUrl in src/config/site.ts to
 * switch the placeholder below for the real links.
 */

import { Icon } from 'astro-icon/components';

import BaseLayout from '../layouts/BaseLayout.astro';
import HexGrid from '../components/HexGrid.astro';
import Prompt from '../components/Prompt.astro';
import { CLUB, PERIODS } from '../config/site';
import { formatPeriod } from '../lib/schedule';

// Until somebody fills in the real form links, show an honest placeholder
// rather than an iframe pointed at nothing.
const hasForm = CLUB.interestFormUrl.length > 0;
const hasEmbeddedForm = CLUB.interestFormEmbedUrl.length > 0;

/** What a first meeting is actually like. Written to lower the barrier. */
const EXPECTATIONS = [
  {
    icon: 'user-round-check',
    title: 'No experience needed',
    blurb:
      'Most people here started with none. If you have never opened a code editor, you are exactly who these meetings are for.',
  },
  {
    icon: 'laptop',
    title: 'Bring a laptop if you have one',
    blurb:
      'A Chromebook is fine — a lot of what we do runs in a browser. If you do not have one, use a lab machine.',
  },
  {
    icon: 'calendar-check',
    title: 'Come when you can',
    blurb:
      'Sports, work, and other clubs happen. Show up when you are able; nobody is keeping an attendance streak.',
  },
  {
    icon: 'heart-handshake',
    title: 'Help the person next to you',
    blurb:
      'The only real rule. Nobody here gets mocked for not knowing something, ever.',
  },
];
---

<BaseLayout
  title="Join"
  description="How to join Dev Club at Novato High School: meeting times, what to expect, and the interest form."
>
  <section class="relative overflow-hidden border-b border-edge">
    <HexGrid class="opacity-50" />
    <div class="relative mx-auto max-w-6xl px-5 py-16">
      <Prompt command="dev-club join --request-access" />
      <h1 class="mt-4 font-mono text-4xl font-bold tracking-tight">Join</h1>
      <p class="mt-5 max-w-xl leading-relaxed text-muted">
        Turn up to a meeting. That is the whole process. Everything below is
        just detail.
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------------
      WHEN AND WHERE
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="rounded-lg border border-edge bg-surface p-6 sm:p-8">
      <Prompt command="cat meeting.txt" />

      <dl class="mt-5 grid gap-5 font-mono text-sm sm:grid-cols-3">
        <div>
          <dt class="text-muted">when</dt>
          <dd class="mt-1 text-lg text-gold">{CLUB.meetingDay}</dd>
        </div>
        <div>
          <dt class="text-muted">time</dt>
          <dd class="mt-1 text-lg text-gold">{formatPeriod(PERIODS.regular)}</dd>
        </div>
        <div>
          <dt class="text-muted">where</dt>
          <dd class="mt-1 text-lg text-gold">{CLUB.meetingRoom}</dd>
        </div>
      </dl>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        {
          !hasForm && (
            <p class="rounded border border-dashed border-edge px-5 py-3 font-mono text-sm text-muted">
              Interest form link coming soon &mdash; for now, just come to a
              meeting or email {CLUB.advisorName}.
            </p>
          )
        }

        {
          hasForm && (
            <a
              href={CLUB.interestFormUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 font-mono text-sm text-cyan transition-colors hover:text-gold"
            >
              <Icon name="lucide:external-link" class="h-4 w-4" />
              Open the form in a new tab
            </a>
          )
        }

        {
          CLUB.advisorEmail && (
            <a
              href={`mailto:${CLUB.advisorEmail}`}
              class="font-mono text-sm text-cyan transition-colors hover:text-gold"
            >
              email {CLUB.advisorName}
            </a>
          )
        }
      </div>

      {
        hasEmbeddedForm && (
          <div class="mt-8">
            {/*
              The form requires signing in (that is what stops duplicate
              submissions), so a signed-out visitor sees Google's sign-in
              prompt instead of the questions — much shorter content, same
              fixed box, hence the empty space below it. That is expected,
              not broken, so the note below says so instead of implying
              something is wrong with the embed.

              Google also gives an embedded form no way to tell this page how
              tall its content is (no resize event, and the iframe is
              cross-origin, so we cannot read into it either) — the Expand
              button is a manual stand-in for that. It only changes a CSS
              class, so refreshing or coming back always starts compact again;
              nothing about the expanded state is remembered anywhere.
            */}
            <p class="mb-2 font-mono text-xs text-muted">
              Mostly blank below? The form requires signing in to a Google
              account first, and the sign-in prompt is much shorter than the
              real form &mdash; that is expected, not broken. Sign in and the
              questions will take over the space. Still stuck? Use "Open the
              form in a new tab" above instead.
            </p>
            <div class="overflow-hidden rounded border border-edge bg-white">
              <iframe
                id="join-form-frame"
                src={CLUB.interestFormEmbedUrl}
                title="Dev Club interest form"
                loading="lazy"
                class="block h-[620px] w-full max-w-[450px] border-0 transition-[height] duration-200"
              >
                Loading&hellip;
              </iframe>
            </div>
            <button
              type="button"
              id="join-form-expand"
              hidden
              aria-expanded="false"
              class="mt-2 rounded border border-edge px-3 py-1.5 font-mono text-xs text-muted transition-colors hover:text-gold"
            >
              Expand form &#8597;
            </button>
          </div>
        )
      }
    </div>
  </section>

  {/* ------------------------------------------------------------------
      WHAT TO EXPECT
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 pb-14">
    <Prompt command="cat expectations.md" />
    <h2 class="mt-3 font-mono text-2xl font-semibold">What to expect</h2>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        EXPECTATIONS.map((item) => (
          <div class="rounded-lg border border-edge bg-surface p-6">
            <div class="flex items-center gap-3">
              <Icon name={`lucide:${item.icon}`} class="h-5 w-5 text-gold" />
              <h3 class="font-mono text-base font-semibold">{item.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ------------------------------------------------------------------
      PRIVACY — worth stating plainly on the page that asks people to sign up.
  ------------------------------------------------------------------ */}
  <section class="mx-auto max-w-6xl px-5 pb-16">
    <div class="rounded-lg border border-edge p-6">
      <h2 class="font-mono text-sm font-semibold text-bone">
        About your information
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        This website collects nothing itself. It has no accounts, no tracking,
        and no database &mdash; it is a set of plain files served by GitHub.
        The sign-up form embedded above is Google's: it loads directly from
        Google's servers, and submitting it sends your answers straight to
        the school's own Google account, the same as opening the form in its
        own tab would. Club members are credited on this site by GitHub
        username only, never by full name.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: the form works fine at its default compact size
  // without this, so the button only appears once JS proves it can act on a
  // click. Nothing here is saved anywhere (no localStorage, no cookie) — a
  // reload or a later visit always starts compact again, on purpose.
  const frame = document.getElementById('join-form-frame');
  const toggle = document.getElementById('join-form-expand');
  const COMPACT = 'h-[620px]';
  const EXPANDED = 'h-[1250px]';

  if (frame && toggle) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const expanding = !frame.classList.contains(EXPANDED);
      frame.classList.toggle(COMPACT, !expanding);
      frame.classList.toggle(EXPANDED, expanding);
      toggle.textContent = expanding ? 'Shrink form ↕' : 'Expand form ↕';
      toggle.setAttribute('aria-expanded', String(expanding));
    });
  }
</script>
