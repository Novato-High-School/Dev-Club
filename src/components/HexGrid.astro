---
/**
 * HEX GRID BACKGROUND
 * ===================
 * The faint honeycomb pattern behind the top of each page. It is our hornet
 * reference, done with geometry instead of a cartoon mascot.
 *
 * The whole thing is one SVG pattern drawn by the browser, so it costs no
 * image downloads and stays sharp on any screen.
 */

interface Props {
  /** Extra Tailwind classes, usually to position or fade the grid. */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
  aria-hidden="true"
>
  <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- One hexagon, repeated across the whole area by the browser. -->
      <pattern
        id="hexes"
        width="56"
        height="48"
        patternUnits="userSpaceOnUse"
        patternTransform="scale(1)"
      >
        <path
          d="M28 0 L56 16 L56 40 L28 56 L0 40 L0 16 Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        ></path>
      </pattern>
      <!-- Fades the grid out towards the bottom so it never fights with text. -->
      <linearGradient id="hexFade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="white" stop-opacity="0.5"></stop>
        <stop offset="100%" stop-color="white" stop-opacity="0"></stop>
      </linearGradient>
      <mask id="hexMask">
        <rect width="100%" height="100%" fill="url(#hexFade)"></rect>
      </mask>
    </defs>
    <rect
      width="100%"
      height="100%"
      fill="url(#hexes)"
      mask="url(#hexMask)"
      class="text-gold/15"
    ></rect>
  </svg>
</div>
