---
/**
 * PROJECT CARD
 * ============
 * One club project, displayed to look like a repository listing on GitHub.
 * The Build page creates one of these for every file in
 * src/content/projects/.
 */

import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  summary: string;
  status: 'idea' | 'building' | 'shipped' | 'archived';
  tech?: string[];
  repo?: string;
  demo?: string;
  contributors?: string[];
}

const {
  title,
  summary,
  status,
  tech = [],
  repo,
  demo,
  contributors = [],
} = Astro.props;

/**
 * How each status looks. Keeping this in one place means a status colour is
 * changed once rather than hunted for in the markup below.
 */
const STATUS_STYLES: Record<Props['status'], string> = {
  idea: 'border-cyan/40 text-cyan',
  building: 'border-gold/40 text-gold',
  shipped: 'border-acid/40 text-acid',
  archived: 'border-edge text-muted',
};

// A brand new project may have no repo, no demo, and nobody signed up yet.
// In that case we leave the footer bar off the card entirely, rather than
// drawing an empty line across the bottom of it.
const hasFooter = Boolean(repo || demo || contributors.length > 0);

// Friendlier wording than the raw value stored in the Markdown file.
const STATUS_LABELS: Record<Props['status'], string> = {
  idea: 'idea',
  building: 'in progress',
  shipped: 'shipped',
  archived: 'archived',
};
---

<article
  class="group flex h-full flex-col rounded-lg border border-edge bg-surface p-5 transition-colors hover:border-gold/40"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-mono text-lg font-semibold text-bone">
      {title}
    </h3>
    <span
      class:list={[
        'shrink-0 rounded-full border px-2.5 py-0.5 font-mono text-xs',
        STATUS_STYLES[status],
      ]}
    >
      {STATUS_LABELS[status]}
    </span>
  </div>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{summary}</p>

  {/* The technologies used, shown as small tags like GitHub's language chips. */}
  {
    tech.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tech.map((item) => (
          <li class="rounded border border-edge px-2 py-0.5 font-mono text-xs text-muted">
            {item}
          </li>
        ))}
      </ul>
    )
  }

  {/* The footer bar, left off entirely when there is nothing to put in it. */}
  {
    hasFooter && (
      <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-edge pt-4 text-xs">
        {repo && (
          <a
            href={repo}
            class="inline-flex items-center gap-1.5 font-mono text-muted transition-colors hover:text-cyan"
          >
            <Icon name="lucide:github" class="h-3.5 w-3.5" />
            code
          </a>
        )}

        {demo && (
          <a
            href={demo}
            class="inline-flex items-center gap-1.5 font-mono text-muted transition-colors hover:text-cyan"
          >
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
            demo
          </a>
        )}

        {/* Contributors are credited by GitHub username only, never real names. */}
        {contributors.length > 0 && (
          <span class="ml-auto font-mono text-muted">
            {contributors.map((user) => `@${user}`).join(' ')}
          </span>
        )}
      </div>
    )
  }
</article>
